    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Get the model's JSON text\nconst txt = $('Tailored Resume').item.json.message.content;\n\n// Safely extract the first {...} block if the model added extra text\nfunction extractFirstJson(s) {\n  const start = s.indexOf('{');\n  const end = s.lastIndexOf('}');\n  if (start === -1 || end === -1 || end <= start) {\n    throw new Error('No JSON object found in model output');\n  }\n  return s.slice(start, end + 1);\n}\n\nlet obj;\ntry {\n  obj = JSON.parse(txt);\n} catch {\n  obj = JSON.parse(extractFirstJson(txt));\n}\n\n// Build replaceAllText requests from keys\nconst requests = [];\nfor (const [k, v] of Object.entries(obj)) {\n  if (v === undefined || v === null) continue;\n  requests.push({\n    replaceAllText: {\n      containsText: { text: `{{${k}}}`, matchCase: true },\n      replaceText: String(v),\n    },\n  });\n}\n\n// Pass the new Doc ID from the Copy node (current item)\nconst newDocId = $json.id; // or $('Copy').item.json.id if needed\n\nreturn {\n  json: { newDocId, requests },\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        -96
      ],
      "id": "18a7cb55-fa46-4f0b-902f-09bcbeefc015",
      "name": "Resume-Parse AI JSON & Build Requests"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// --- 1) Get the model's JSON text from the Tailored Cover Letter model node\nconst txt = $node[\"Tailored Cover letter\"].json.message.content;\n\n// --- 2) Extract JSON even if the model added text around it\nfunction extractFirstJson(s) {\n  const start = s.indexOf(\"{\");\n  const end = s.lastIndexOf(\"}\");\n  if (start === -1 || end === -1 || end <= start) {\n    throw new Error(\"No JSON object found in model output\");\n  }\n  return s.slice(start, end + 1);\n}\n\nlet obj;\ntry {\n  obj = JSON.parse(txt);\n} catch {\n  obj = JSON.parse(extractFirstJson(txt));\n}\n\n// --- 3) Keys from the AI-generated JSON\nconst KEYS = [\"P1\", \"P2\", \"P3\", \"P4\", \"CLOSING\"];\n\n// --- 4) Build replaceAllText requests\nconst requests = [];\n\n// ✅ Add COMPANY\nrequests.push({\n  replaceAllText: {\n    containsText: { text: \"{{COMPANY}}\", matchCase: true },\n    replaceText: String($node[\"Fetch Dataset\"].json.company || \"\")\n  }\n});\n\n// ✅ Add LOCATION\nrequests.push({\n  replaceAllText: {\n    containsText: { text: \"{{LOCATION}}\", matchCase: true },\n    replaceText: String($node[\"Fetch Dataset\"].json.location || \"\")\n  }\n});\n\n// ✅ Add P1–P4 + CLOSING paragraphs\nfor (const k of KEYS) {\n  const v = obj[k];\n  if (v === undefined || v === null) continue;\n\n  requests.push({\n    replaceAllText: {\n      containsText: { text: `{{${k}}}`, matchCase: true },\n      replaceText: String(v)\n    }\n  });\n}\n\n// --- 5) Get newDocId from Copy Cover Letter Template node\nlet newDocId;\ntry {\n  newDocId = $node[\"Copy Cover Letter Template\"].json.id;\n} catch (e) {\n  newDocId = $json.id;\n}\n\nif (!newDocId) {\n  throw new Error(\"newDocId missing — ensure Copy Cover Letter Template runs before this node\");\n}\n\n// --- 6) Return final JSON for Google Docs batchUpdate\nreturn {\n  json: { newDocId, requests }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
